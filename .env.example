# Copy to .env on the VPS and fill in. Never commit the real .env.

# paper = simulated fills only. live = real orders on BINANCE_ENV.
TRADING_MODE=paper
# mainnet = real Binance. testnet = testnet.binancefuture.com (fake money; its own API keys).
BINANCE_ENV=mainnet
# Required for TRADING_MODE=live on mainnet. It must equal exactly: I_ACCEPT_REAL_ORDERS
LIVE_TRADING_ACK=

# Fraction of account equity risked at the stop on each trade.
# Suggested for the first live weeks: 0.0025 (a quarter of the research setting).
RISK_PER_TRADE=0.01
# Total notional cap as a multiple of equity, split evenly across markets.
MAX_LEVERAGE=3
# Leverage set on Binance per symbol. It only affects margin, because sizing above caps the notional.
# Must be >= MAX_LEVERAGE.
LEVERAGE_SETTING=5
# Pause new entries after this drawdown from peak (stops stay active). /resume restarts.
MAX_DRAWDOWN_PAUSE=0.35
# Skip entries if the signal is older than this many minutes (e.g. after downtime). Exits always run.
MAX_ENTRY_DELAY_MIN=10
# Stop trigger price: CONTRACT_PRICE (last trade; matches the backtest) or MARK_PRICE.
STOP_WORKING_TYPE=CONTRACT_PRICE
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT
# Paper balance (ignored in live mode, which uses the real account balance).
PAPER_EQUITY=10000
# Also paper-trade F1 long-only; it stays quiet and only appears in the daily summary.
SHADOW_LONG_ONLY=true
# Also paper-trade Round 5's D1 daily trend ensemble (information only; see research/PREREGISTRATION.md).
# It needs BTCUSDT, ETHUSDT, SOLUSDT, XRPUSDT and BNBUSDT in SYMBOLS. Quiet: daily summary, /d1 and the dashboard.
D1_SHADOW=true
STATE_DIR=state

# Web dashboard login (docker compose service "dashboard", port 8080).
DASHBOARD_USER=admin
# Use 16+ random characters if the dashboard is public, e.g. the output of: openssl rand -base64 18
DASHBOARD_PASSWORD=
# 127.0.0.1 = only reachable on the VPS (open it through an SSH tunnel; safest).
# 0.0.0.0   = reachable at http://<vps-ip>:8080 from anywhere. Plain HTTP: the password crosses the network
#             unencrypted, so use a unique password. 10 wrong logins lock an IP out for 15 minutes.
DASHBOARD_BIND=127.0.0.1

# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Message your bot once, then run: python -m btcq.live chat-id
TELEGRAM_CHAT_ID=

# Futures API key: enable "Futures" only, NO withdrawals, restrict to the VPS IP.
# Use a dedicated (sub-)account: the bot assumes it owns every position on these symbols.
BINANCE_API_KEY=
BINANCE_API_SECRET=
